######### DECREMENT AND LOOP ##############
LOOPX:              OPD,
                    DECX, UP_CC     # DECX selects OPN0=X too
                    BRANCH_BNZ,
                    NI

LOOPB:              OPD
                    DECB, UP_CC
                    BRANCH_BNZ,
                    NI

######### STRING OPERATIONS ##############
MOVE:               ADDRY
                    WE,  ADDRX, UP_MOVE     # Y+, X+, U-
                    WAIT 9
                    NI

BMOVE_START:        WAIT 3
                    NOP
                    ADDRY
                    WE, ADDRX, UP_MOVE
                    WAIT 2
                    NOP
                    UC_LOOP

BMOVE:              NIUZ
                    NOP
                    ADDRY
                    WE, ADDRX, UP_MOVE             # Y+, X+, U-
                    WAIT 2
                    UC_LOOP

BSETA_START:        WAIT 3
                    ADDRX, WE, INCX, DECU
                    NOP
                    UC_LOOP

BSETA:              NIUZ
                    ADDRX, WE, INCX, DECU
                    UC_LOOP

BSETD_START:        WAIT 3
                    NOP
                    WE, ADDRX, INCX, DECU
                    WE, ADDRX, INCX
                    WAIT 2
                    NOP
                    UC_LOOP

BSETD:              NIUZ
                    NOP
                    WE, ADDRX, INCX, DECU
                    WE, ADDRX, INCX
                    WAIT 2
                    UC_LOOP

