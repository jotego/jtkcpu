########### INTERRUPTS ####################
RESET:              INT_EN, I=1, F=1
                    WAIT 3
                    NI
                    NOP

# Do not make FIRQ, IRQ or NMI ucode longer than 6 instructions
# or it will fail
FIRQ:               E=0,PSH_CC, PSH_GO
                    F=1, I=1
                    NOP
                    INT_EN, E=0, F=1, I=1
                    NOP
                    DYNWAIT
                    NI

IRQ:                E=1, PSH_ALL, PSH_GO
                    I=1
                    NOP
                    INT_EN, E=1, I=1
                    NOP
                    DYNWAIT
                    NI

NMI:                E=1, PSH_ALL, PSH_GO
                    I=1, F=1
                    NOP
                    INT_EN, E=1, I=1, F=1
                    NOP
                    DYNWAIT
                    NI

BRSWI:              OPD
                    PC=BRANCH8
                    NOP
                    FAKE_IRQ=1
                    NOP
                    NI


BUSERROR:           BUSERROR

########## INDEX ADDR ##################
PARSE_IDX:          OPD
                    IDX_JMP
                    # IDX_IND either jumps to IDX_IND or
                    # does a IDX_RET depending on the indirect bit
IDX_R:              NOP
                    IDX_IND
IDX_RINC:           IDX_POST=1                  # 0 - R+
                    IDX_IND
IDX_RINC2:          IDX_POST=1, IDXW=1          # 1 - R++ / [R++]
                    NOP
                    IDX_IND
IDX_RDEC:           IDX_PRE
                    IDX_IND                     # 2 -  -R
IDX_RDEC2:          IDXW=1
                    IDX_PRE
                    IDX_IND                     # 3 - --R
IDX_OFFSET8:        OPD                         # 4 -  8-bit offset
                    WAIT 5
                    IDX_8, IDX_IND
IDX_OFFSET16:       OPD, MEMHI                  # 5 - 16-bit offset
                    OPD
                    WAIT 5
                    IDX_16, IDX_IND
IDX_IND:            IDX_EN, MEMHI               # 6 - ,R
                    IDX_EN, IDX_ADV
                    WAIT 3
                    DATA2ADDR, IDX_RET
IDX_EXT:            OPD, MEMHI                  # 7 Extended
                    OPD
                    WAIT 4
                    DATA2ADDR, IDX_IND
IDX_DP:             OPD                         # 1,4  - DP
                    WAIT 3
                    IDX_DP, IDX_IND
IDX_ACC:            NOP
                    WAIT 2
                    IDX_ACC=1, IDX_IND          # 1,other  - A, B, X, Y, U, S or D
IDX_UNK:            IDX_IND                     # Reserved indexed category; invalid modes normally buserror

